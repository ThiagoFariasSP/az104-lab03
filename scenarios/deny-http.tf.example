resource "azurerm_network_security_rule" "deny_http_from_pe" {
  name                        = "Deny-HTTP-From-PE"
  description                 = "AZ-104 lab rule to block HTTP between lab subnets for Network Watcher troubleshooting."
  priority                    = 110
  direction                   = "Inbound"
  access                      = "Deny"
  protocol                    = "Tcp"
  source_port_range           = "*"
  destination_port_range      = "80"
  source_address_prefix       = "172.16.0.0/24"
  destination_address_prefix  = "172.16.2.0/24"
  resource_group_name         = azurerm_resource_group.res-1.name
  network_security_group_name = azurerm_network_security_group.res-10.name
}
